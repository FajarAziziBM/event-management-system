<div class="max-w-3xl mx-auto px-4 py-10">
  <a href="/orders" class="text-indigo-600 text-sm font-medium hover:underline mb-4 inline-block"><i class="fas fa-arrow-left mr-1"></i>Kembali ke Pesanan Saya</a>

  <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
    <div class="flex items-start justify-between flex-wrap gap-3 mb-5">
      <div>
        <p class="text-xs font-mono text-gray-400 mb-1"><%= order.orderNumber %></p>
        <h1 class="text-xl font-bold text-gray-900"><%= order.event ? order.event.title : 'Event tidak tersedia' %></h1>
      </div>
      <% if (order.paymentStatus==='paid' ) { %>
      <span class="bg-green-100 text-green-700 text-sm font-semibold px-3 py-1 rounded-full">Lunas</span>
      <% } else if (order.paymentStatus==='pending' ) { %>
      <span class="bg-yellow-100 text-yellow-700 text-sm font-semibold px-3 py-1 rounded-full">Menunggu Pembayaran</span>
      <% } else if (order.paymentStatus==='expired' ) { %>
      <span class="bg-red-100 text-red-700 text-sm font-semibold px-3 py-1 rounded-full">Kedaluwarsa</span>
      <% } else if (order.paymentStatus==='cancelled' ) { %>
      <span class="bg-gray-100 text-gray-600 text-sm font-semibold px-3 py-1 rounded-full">Dibatalkan</span>
      <% } else if (order.paymentStatus==='refunded' ) { %>
      <span class="bg-blue-100 text-blue-700 text-sm font-semibold px-3 py-1 rounded-full">Refund</span>
      <% } %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm mb-5">
      <div>
        <p class="text-gray-400 text-xs mb-1">Tanggal Pesan</p>
        <p class="font-semibold text-gray-800"><%= formatDate(order.createdAt) %></p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-1">Jumlah Tiket</p>
        <p class="font-semibold text-gray-800"><%= order.quantity %> tiket</p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-1">Total Bayar</p>
        <p class="font-semibold text-gray-800"><%= formatCurrency(order.totalAmount) %></p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-1">Venue</p>
        <p class="font-semibold text-gray-800 line-clamp-1"><%= order.event ? order.event.venue : '-' %></p>
      </div>
    </div>

    <% if (order.paymentStatus==='pending' ) { %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center gap-3 justify-between" id="pending-box" data-order-id="<%= order.id %>">
      <p class="text-yellow-800 text-sm"><i class="fas fa-clock mr-1"></i>Selesaikan pembayaran sebelum <%= formatDateTime(order.expiredAt) %>.</p>
      <div class="flex gap-2 shrink-0">
        <form method="POST" action="/orders/<%= order.id %>/cancel" onsubmit="return confirm('Batalkan pesanan ini?');">
          <button type="submit" class="border border-gray-300 text-gray-600 px-4 py-2 rounded-xl text-sm font-semibold hover:bg-gray-50 transition-colors">Batalkan</button>
        </form>
        <% if (paymentUrl) { %>
        <a href="<%= paymentUrl %>" class="bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-indigo-700 transition-colors">Bayar Sekarang</a>
        <% } %>
      </div>
    </div>
    <script>
      // Polling ringan: kalau pembayaran selesai di tab lain, refresh otomatis biar status ter-update
      (function () {
        var box = document.getElementById('pending-box');
        if (!box) return;
        var orderId = box.dataset.orderId;
        var interval = setInterval(function () {
          fetch('/orders/' + orderId + '/status')
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.orderStatus && data.orderStatus !== 'pending') {
                clearInterval(interval);
                window.location.reload();
              }
            })
            .catch(function () {});
        }, 8000);
      })();
    </script>
    <% } else if (order.paymentStatus==='expired' ) { %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 flex items-center justify-between flex-wrap gap-3">
      <p class="text-red-700 text-sm"><i class="fas fa-circle-exclamation mr-1"></i>Waktu pembayaran sudah habis.</p>
      <% if (order.event) { %>
      <a href="/events/<%= order.event.slug %>" class="bg-white border border-red-300 text-red-700 px-4 py-2 rounded-xl text-sm font-semibold hover:bg-red-50 transition-colors">Pesan Ulang</a>
      <% } %>
    </div>
    <% } %>
  </div>

  <% if (order.paymentStatus==='paid' && order.tickets && order.tickets.length> 0) { %>
  <div class="bg-white rounded-2xl border border-gray-100 p-6">
    <h2 class="font-bold text-gray-900 mb-4"><i class="fas fa-ticket mr-2 text-indigo-600"></i>Tiket Anda</h2>
    <div class="space-y-3">
      <% order.tickets.forEach(function(ticket, idx) { %>
      <a href="/tickets/<%= ticket.id %>" class="flex items-center justify-between border border-gray-100 rounded-xl p-4 hover:border-indigo-300 transition-colors">
        <div>
          <p class="font-semibold text-gray-900">Tiket #<%= idx + 1 %></p>
          <p class="text-xs font-mono text-gray-400"><%= ticket.ticketCode %></p>
        </div>
        <div class="flex items-center gap-3">
          <% if (ticket.isCheckedIn) { %>
          <span class="bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-0.5 rounded-full">Sudah Check-in</span>
          <% } %>
          <i class="fas fa-chevron-right text-gray-300"></i>
        </div>
      </a>
      <% }); %>
    </div>
  </div>
  <% } %>
</div>
