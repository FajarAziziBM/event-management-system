<div class="max-w-2xl mx-auto px-4 py-16 text-center">
  <div class="w-20 h-20 mx-auto mb-6 bg-green-100 rounded-full flex items-center justify-center">
    <i class="fas fa-check text-green-600 text-3xl"></i>
  </div>
  <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Pembayaran Berhasil!</h1>
  <p class="text-gray-500 mb-10">Terima kasih, tiket Anda sudah kami terbitkan.</p>

  <% if (order) { %>
  <div class="bg-white rounded-2xl border border-gray-100 p-6 text-left mb-6">
    <p class="text-xs font-mono text-gray-400 mb-1"><%= order.orderNumber %></p>
    <h3 class="font-bold text-gray-900 mb-3"><%= order.event ? order.event.title : '-' %></h3>
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <p class="text-gray-400 text-xs mb-1">Jumlah Tiket</p>
        <p class="font-semibold text-gray-800"><%= order.quantity %> tiket</p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-1">Total Dibayar</p>
        <p class="font-semibold text-gray-800"><%= formatCurrency(order.totalAmount) %></p>
      </div>
    </div>
  </div>
  <div class="flex flex-col sm:flex-row gap-3 justify-center">
    <a href="/orders/<%= order.id %>" class="bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors flex items-center justify-center gap-2">
      <i class="fas fa-ticket"></i> Lihat Tiket Saya
    </a>
    <a href="/events" class="bg-white border border-gray-200 text-gray-700 px-6 py-3 rounded-xl font-semibold hover:bg-gray-50 transition-colors flex items-center justify-center gap-2">
      Jelajahi Event Lain
    </a>
  </div>
  <% } else { %>
  <p class="text-gray-500 mb-6">Cek detail lengkap pesanan Anda di halaman Pesanan Saya.</p>
  <a href="/orders" class="bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors inline-flex items-center gap-2">
    <i class="fas fa-receipt"></i> Lihat Pesanan Saya
  </a>
  <% } %>
</div>
