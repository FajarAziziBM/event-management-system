<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' && title ? title + ' · EventHub' : 'EventHub - Platform Event Terbaik' %></title>
    <meta name="description" content="EventHub — temukan dan ikuti event menarik, atau buat event Anda sendiri." />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <% if (typeof extraHead !=='undefined' ) { %> <%- extraHead %> <% } %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col">
    <%- include('../partials/navbar') %>

    <div class="flash-container fixed top-20 right-4 z-50 w-full max-w-sm space-y-2 px-4 sm:px-0">
      <%- include('../partials/flash') %>
    </div>

    <main class="flex-1">
      <%- body %>
    </main>

    <%- include('../partials/site-footer') %>

    <script nonce="<%= cspNonce %>">
      // Form dengan class 'js-confirm-submit' + data-confirm-message akan
      // menampilkan window.confirm() dulu sebelum submit (dipakai di
      // batalkan pesanan, tarik/tutup/batalkan event, hapus event, dsb).
      // Pakai event delegation di document supaya berlaku untuk seluruh
      // halaman tanpa perlu script terpisah di tiap view.
      document.addEventListener('submit', function (e) {
        var form = e.target.closest('.js-confirm-submit');
        if (form && !window.confirm(form.dataset.confirmMessage || 'Yakin melanjutkan?')) {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>
