<div class="max-w-4xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-gray-900 mb-8">Profil Saya</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Sidebar ringkasan -->
    <div class="space-y-4">
      <div class="bg-white rounded-2xl border border-gray-100 p-6 text-center">
        <img
          src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profileUser.name || profileUser.email) %>&background=4f46e5&color=ffffff&rounded=true&size=80&bold=true"
          class="w-20 h-20 rounded-full mx-auto mb-3"
          alt=""
        />
        <h3 class="font-bold text-gray-900"><%= profileUser.name %></h3>
        <p class="text-gray-400 text-sm mb-3"><%= profileUser.email %></p>
        <span class="inline-block bg-indigo-50 text-indigo-700 text-xs font-semibold px-3 py-1 rounded-full capitalize">
          <%= profileUser.role==='organizer' ? 'Penyelenggara' : (profileUser.role==='admin' ? 'Admin' : 'Peserta' ) %>
        </span>
      </div>
      <div class="bg-white rounded-2xl border border-gray-100 p-5 grid grid-cols-<%= totalEvents !==null ? 2 : 1 %> gap-4 text-center">
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= totalOrders %></p>
          <p class="text-xs text-gray-500">Total Pesanan</p>
        </div>
        <% if (totalEvents !==null) { %>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= totalEvents %></p>
          <p class="text-xs text-gray-500">Event Dibuat</p>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Form -->
    <div class="md:col-span-2 space-y-6">
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h3 class="font-bold text-gray-900 mb-5">Informasi Akun</h3>
        <form method="POST" action="/auth/profile" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Nama Lengkap</label>
            <input type="text" name="name" value="<%= profileUser.name %>" class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
            <input type="email" value="<%= profileUser.email %>" disabled class="w-full border border-gray-200 rounded-xl px-4 py-3 bg-gray-50 text-gray-500" />
            <p class="text-xs text-gray-400 mt-1">Email tidak dapat diubah.</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Nomor Telepon</label>
            <input type="tel" name="phone" value="<%= profileUser.phone || '' %>" placeholder="mis. 081234567890" class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
          </div>
          <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors">
            <i class="fas fa-floppy-disk mr-2"></i>Simpan Perubahan
          </button>
        </form>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h3 class="font-bold text-gray-900 mb-5">Ubah Password</h3>
        <form method="POST" action="/auth/change-password" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Password Lama</label>
            <input type="password" name="oldPassword" required class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Password Baru</label>
              <input type="password" name="newPassword" required minlength="8" class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Konfirmasi Password Baru</label>
              <input type="password" name="confirmPassword" required minlength="8" class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
            </div>
          </div>
          <button type="submit" class="bg-gray-800 text-white px-6 py-3 rounded-xl font-semibold hover:bg-gray-900 transition-colors">
            <i class="fas fa-key mr-2"></i>Ubah Password
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
