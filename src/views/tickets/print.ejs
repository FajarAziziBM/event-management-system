<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="bg-gray-100 min-h-screen flex items-center justify-center py-10">
    <div class="no-print fixed top-4 right-4 flex gap-2">
      <button id="btn-print" class="bg-indigo-600 text-white px-4 py-2 rounded-xl font-semibold shadow-lg hover:bg-indigo-700 transition-colors">
        <i class="fas fa-print mr-2"></i>Cetak
      </button>
      <a href="/tickets/<%= ticket.id %>" class="bg-white text-gray-700 px-4 py-2 rounded-xl font-semibold shadow-lg border border-gray-200 hover:bg-gray-50 transition-colors">Tutup</a>
    </div>

    <div class="print-ticket bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden">
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-5 text-white text-center">
        <p class="text-xs text-indigo-100 uppercase tracking-wide mb-1">E-Tiket EventHub</p>
        <h1 class="font-bold text-lg leading-snug"><%= ticket.event.title %></h1>
      </div>

      <div class="p-6 text-center">
        <img src="<%= ticket.qrCodeImage %>" alt="QR Code" class="w-48 h-48 mx-auto mb-3" />
        <p class="font-mono text-xs text-gray-500 tracking-wider"><%= ticket.ticketCode %></p>
      </div>

      <div class="px-6 pb-6 space-y-3 text-sm border-t border-dashed border-gray-200 pt-4">
        <div class="flex justify-between">
          <span class="text-gray-400">Atas Nama</span>
          <span class="font-semibold text-gray-800"><%= ticket.attendeeName %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Tanggal</span>
          <span class="font-semibold text-gray-800 text-right"><%= formatDateTime(ticket.event.eventDate) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Venue</span>
          <span class="font-semibold text-gray-800 text-right"><%= ticket.event.venue %></span>
        </div>
      </div>

      <div class="bg-gray-50 px-6 py-3 text-center">
        <p class="text-xs text-gray-400">Tunjukkan QR code ini kepada petugas saat masuk venue</p>
      </div>
    </div>

    <script nonce="<%= cspNonce %>">
      document.getElementById('btn-print').addEventListener('click', function () {
        window.print();
      });
    </script>
  </body>
</html>
