<!-- Banner -->
<div class="h-64 md:h-80 relative bg-gradient-to-br from-indigo-600 to-purple-600 overflow-hidden">
  <% if (event.imagePath) { %>
  <img src="<%= assetUrl(event.imagePath) %>" alt="<%= event.title %>" class="w-full h-full object-cover opacity-90" />
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
  <% } %>
  <div class="absolute inset-0 flex items-end">
    <div class="max-w-7xl mx-auto px-4 pb-6 w-full">
      <span class="inline-block bg-white/95 text-indigo-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">
        <i class="fas fa-<%= event.category ? event.category.icon : 'tag' %> mr-1"></i><%= event.category ? event.category.name : 'Umum' %>
      </span>
      <h1 class="text-2xl md:text-4xl font-bold text-white drop-shadow-sm max-w-3xl"><%= event.title %></h1>
    </div>
  </div>
</div>

<% if (isOwner && event.status !=='published' ) { %>
<div class="bg-yellow-50 border-b border-yellow-200">
  <div class="max-w-7xl mx-auto px-4 py-3 text-yellow-800 text-sm flex items-center gap-2">
    <i class="fas fa-eye-slash"></i>
    Event ini berstatus <strong class="capitalize mx-1"><%= event.status %></strong> — hanya Anda (pemilik) dan admin yang bisa melihat halaman ini.
  </div>
</div>
<% } %>

<div class="max-w-7xl mx-auto px-4 py-10 grid grid-cols-1 lg:grid-cols-3 gap-10">
  <!-- Konten utama -->
  <div class="lg:col-span-2 space-y-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-gray-100 p-4">
        <i class="fas fa-calendar-day text-indigo-600 text-xl mb-2"></i>
        <p class="text-xs text-gray-500">Tanggal Mulai</p>
        <p class="font-semibold text-gray-900 text-sm"><%= formatDateTime(event.eventDate) %></p>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-4">
        <i class="fas fa-calendar-check text-indigo-600 text-xl mb-2"></i>
        <p class="text-xs text-gray-500">Tanggal Selesai</p>
        <p class="font-semibold text-gray-900 text-sm"><%= formatDateTime(event.eventEndDate) %></p>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-4">
        <i class="fas fa-location-dot text-indigo-600 text-xl mb-2"></i>
        <p class="text-xs text-gray-500">Venue</p>
        <p class="font-semibold text-gray-900 text-sm line-clamp-1"><%= event.venue %></p>
      </div>
    </div>

    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-3">Tentang Event</h2>
      <p class="text-gray-600 whitespace-pre-line leading-relaxed"><%= event.description %></p>
    </div>

    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-3">Lokasi</h2>
      <div class="bg-white rounded-xl border border-gray-100 p-5">
        <p class="font-semibold text-gray-900"><%= event.venue %></p>
        <p class="text-gray-500 text-sm mt-1"><%= event.address %></p>
      </div>
    </div>

    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-3">Penyelenggara</h2>
      <div class="bg-white rounded-xl border border-gray-100 p-5 flex items-center gap-3">
        <img
          src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(event.creator ? event.creator.name : 'Organizer') %>&background=e0e7ff&color=4338ca&rounded=true&size=48&bold=true"
          class="w-12 h-12 rounded-full"
          alt=""
        />
        <div>
          <p class="font-semibold text-gray-900"><%= event.creator ? event.creator.name : '-' %></p>
          <p class="text-gray-500 text-sm">Penyelenggara Event</p>
        </div>
      </div>
    </div>

    <% if (event.attachments && event.attachments.length> 0) { %>
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-3">Lampiran</h2>
      <div class="space-y-2">
        <% event.attachments.forEach(function(att) { %>
        <a href="<%= assetUrl(att.filePath) %>" target="_blank" rel="noopener" class="flex items-center gap-3 bg-white rounded-xl border border-gray-100 p-4 hover:border-indigo-300 transition-colors">
          <i class="fas fa-paperclip text-indigo-600"></i>
          <span class="text-gray-700 text-sm"><%= att.fileName %></span>
        </a>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Sidebar aksi -->
  <div>
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 sticky top-24">
      <% if (isOwner) { %>
      <!-- Pemilik event: kelola, bukan beli -->
      <p class="text-xs text-gray-500 mb-1">Status Event</p>
      <p class="font-bold text-lg mb-4 capitalize <%= event.status==='published' ? 'text-green-600' : (event.status==='draft' ? 'text-gray-600' : 'text-red-600') %>">
        <%= event.status %>
      </p>
      <div class="grid grid-cols-2 gap-3 text-center mb-5">
        <div class="bg-gray-50 rounded-xl py-3">
          <p class="text-xl font-bold text-gray-900"><%= event.maxAttendees %></p>
          <p class="text-xs text-gray-500">Kapasitas</p>
        </div>
        <div class="bg-gray-50 rounded-xl py-3">
          <p class="text-xl font-bold text-gray-900"><%= event.availableTicket %></p>
          <p class="text-xs text-gray-500">Tersisa</p>
        </div>
      </div>
      <a href="/events/<%= event.id %>/edit" class="w-full mb-3 bg-indigo-600 text-white py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors flex items-center justify-center gap-2">
        <i class="fas fa-pen"></i> Kelola Event
      </a>
      <% } else if (!user) { %>
      <!-- Belum login -->
      <p class="text-sm text-gray-500 mb-1">Harga Tiket</p>
      <p class="text-3xl font-bold text-gray-900 mb-5"><%= Number(event.ticketPrice)===0 ? 'Gratis' : formatCurrency(event.ticketPrice) %></p>
      <a
        href="/auth/login?redirect=<%= encodeURIComponent('/events/' + event.slug) %>"
        class="w-full bg-indigo-600 text-white py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors flex items-center justify-center gap-2"
      >
        <i class="fas fa-right-to-bracket"></i> Login untuk Membeli
      </a>
      <p class="text-center text-sm text-gray-500 mt-3">
        Belum punya akun? <a href="/auth/register" class="text-indigo-600 font-semibold hover:underline">Daftar di sini</a>
      </p>
      <% } else if (event.status !=='published' ) { %>
      <p class="text-gray-500 text-sm"><i class="fas fa-circle-info mr-1"></i>Event ini sedang tidak menerima pemesanan.</p>
      <% } else if (event.availableTicket <=0) { %>
      <p class="text-sm text-gray-500 mb-1">Harga Tiket</p>
      <p class="text-3xl font-bold text-gray-900 mb-5"><%= formatCurrency(event.ticketPrice) %></p>
      <button type="button" disabled class="w-full bg-gray-200 text-gray-500 py-3 rounded-xl font-semibold cursor-not-allowed">Tiket Habis</button>
      <% } else { %>
      <!-- Bisa beli -->
      <p class="text-sm text-gray-500 mb-1">Harga Tiket</p>
      <p class="text-3xl font-bold text-gray-900 mb-1"><%= Number(event.ticketPrice)===0 ? 'Gratis' : formatCurrency(event.ticketPrice) %></p>
      <p class="text-sm text-gray-500 mb-5"><i class="fas fa-ticket mr-1"></i><%= event.availableTicket %> tiket tersisa</p>
      <form method="GET" action="/events/<%= event.slug %>/checkout">
        <label class="block text-sm font-medium text-gray-700 mb-2">Jumlah Tiket</label>
        <select name="qty" class="w-full border border-gray-200 rounded-xl px-4 py-3 mb-4 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
          <% for (let q=1; q <=Math.min(event.availableTicket, 5); q++) { %>
          <option value="<%= q %>"><%= q %> tiket</option>
          <% } %>
        </select>
        <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors flex items-center justify-center gap-2">
          <i class="fas fa-cart-shopping"></i> Beli Tiket
        </button>
      </form>
      <% } %>
    </div>
  </div>
</div>
