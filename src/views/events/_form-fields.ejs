<% /* Partial dipakai oleh events/create.ejs & events/edit.ejs.
      Butuh local vars: values, errors, categories */ %>
<% if (errors._general) { %>
<div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-6 text-sm flex items-center gap-2">
  <i class="fas fa-circle-exclamation"></i> <%= errors._general %>
</div>
<% } %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="md:col-span-2">
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Judul Event</label>
    <input
      type="text"
      name="title"
      value="<%= values.title || '' %>"
      placeholder="mis. Konferensi Teknologi Indonesia 2026"
      class="w-full border <%= errors.title ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <% if (errors.title) { %><p class="text-red-500 text-xs mt-1"><%= errors.title %></p><% } %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Kategori</label>
    <select
      name="categoryId"
      class="w-full border <%= errors.categoryId ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    >
      <option value="">Pilih kategori</option>
      <% categories.forEach(function(cat) { %>
      <option value="<%= cat.id %>" <%= String(values.categoryId)===String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
      <% }); %>
    </select>
    <% if (errors.categoryId) { %><p class="text-red-500 text-xs mt-1"><%= errors.categoryId %></p><% } %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Kapasitas (jumlah tiket)</label>
    <input
      type="number"
      min="1"
      name="maxAttendees"
      value="<%= values.maxAttendees || '' %>"
      placeholder="mis. 200"
      class="w-full border <%= errors.maxAttendees ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <% if (errors.maxAttendees) { %><p class="text-red-500 text-xs mt-1"><%= errors.maxAttendees %></p><% } %>
  </div>

  <div class="md:col-span-2">
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Deskripsi</label>
    <textarea
      name="description"
      rows="5"
      placeholder="Ceritakan tentang event Anda, minimal 20 karakter..."
      class="w-full border <%= errors.description ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    ><%= values.description || '' %></textarea>
    <% if (errors.description) { %><p class="text-red-500 text-xs mt-1"><%= errors.description %></p><% } %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Tanggal &amp; Waktu Mulai</label>
    <input
      type="datetime-local"
      name="eventDate"
      value="<%= values.eventDate ? new Date(values.eventDate).toISOString().slice(0,16) : '' %>"
      class="w-full border <%= errors.eventDate ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <% if (errors.eventDate) { %><p class="text-red-500 text-xs mt-1"><%= errors.eventDate %></p><% } %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Tanggal &amp; Waktu Selesai</label>
    <input
      type="datetime-local"
      name="eventEndDate"
      value="<%= values.eventEndDate ? new Date(values.eventEndDate).toISOString().slice(0,16) : '' %>"
      class="w-full border <%= errors.eventEndDate ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <% if (errors.eventEndDate) { %><p class="text-red-500 text-xs mt-1"><%= errors.eventEndDate %></p><% } %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Venue</label>
    <input
      type="text"
      name="venue"
      value="<%= values.venue || '' %>"
      placeholder="mis. Jakarta Convention Center"
      class="w-full border <%= errors.venue ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <% if (errors.venue) { %><p class="text-red-500 text-xs mt-1"><%= errors.venue %></p><% } %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Harga Tiket (Rp) — isi 0 jika gratis</label>
    <input
      type="number"
      min="0"
      step="1000"
      name="ticketPrice"
      value="<%= values.ticketPrice ?? '' %>"
      placeholder="mis. 150000"
      class="w-full border <%= errors.ticketPrice ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    />
    <% if (errors.ticketPrice) { %><p class="text-red-500 text-xs mt-1"><%= errors.ticketPrice %></p><% } %>
  </div>

  <div class="md:col-span-2">
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Alamat Lengkap</label>
    <textarea
      name="address"
      rows="2"
      placeholder="Jalan, kota, kode pos..."
      class="w-full border <%= errors.address ? 'border-red-400' : 'border-gray-200' %> rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
    ><%= values.address || '' %></textarea>
    <% if (errors.address) { %><p class="text-red-500 text-xs mt-1"><%= errors.address %></p><% } %>
  </div>
</div>
