<!-- Hero -->
<section class="relative bg-gradient-to-br from-indigo-700 via-indigo-600 to-purple-600 overflow-hidden">
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 30%, white 2px, transparent 2px), radial-gradient(circle at 80% 70%, white 2px, transparent 2px); background-size: 60px 60px;"></div>
  <div class="max-w-7xl mx-auto px-4 py-20 md:py-28 relative text-center">
    <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">
      Temukan &amp; Ikuti Event<br />Terbaik di Sekitar Anda
    </h1>
    <p class="text-indigo-100 text-lg mb-10 max-w-2xl mx-auto">
      Konser, seminar, workshop, hingga kompetisi — pesan tiketnya lewat EventHub, bayar aman dengan VA, e-wallet, kartu kredit, atau QRIS.
    </p>

    <form method="GET" action="/events" class="bg-white rounded-2xl shadow-xl p-3 flex flex-col sm:flex-row gap-3 max-w-2xl mx-auto">
      <div class="flex-1 relative">
        <i class="fas fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <input
          type="text"
          name="q"
          placeholder="Cari event, konser, workshop..."
          class="w-full pl-11 pr-4 py-3 rounded-xl border-0 focus:ring-2 focus:ring-indigo-500 text-gray-800"
        />
      </div>
      <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors">
        Cari Event
      </button>
    </form>

    <% if (!user) { %>
    <p class="text-indigo-100 mt-6 text-sm">
      Ingin membuat event sendiri?
      <a href="/auth/register" class="text-white font-semibold underline hover:text-indigo-200">Daftar sebagai penyelenggara</a>
    </p>
    <% } %>
  </div>
</section>

<!-- Kategori -->
<section class="max-w-7xl mx-auto px-4 py-14">
  <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Jelajahi Berdasarkan Kategori</h2>
  <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 gap-4">
    <% categories.forEach(function(cat) { %>
    <a href="/events?category=<%= cat.id %>" class="bg-white border border-gray-100 rounded-2xl p-4 text-center hover:shadow-lg hover:-translate-y-0.5 transition-all group">
      <div class="w-12 h-12 mx-auto mb-2 bg-indigo-50 rounded-xl flex items-center justify-center group-hover:bg-indigo-600 transition-colors">
        <i class="fas fa-<%= cat.icon || 'tag' %> text-indigo-600 group-hover:text-white transition-colors"></i>
      </div>
      <p class="text-xs font-medium text-gray-700 line-clamp-1"><%= cat.name %></p>
    </a>
    <% }); %>
  </div>
</section>

<!-- Event mendatang -->
<section class="bg-white py-14 border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900">Event Terdekat</h2>
      <a href="/events" class="text-indigo-600 font-semibold hover:underline text-sm">Lihat Semua →</a>
    </div>

    <% if (featuredEvents.length===0) { %>
    <div class="text-center py-16">
      <i class="fas fa-calendar-days text-gray-300 text-5xl mb-4"></i>
      <p class="text-gray-500">Belum ada event yang dipublikasikan saat ini. Cek lagi nanti ya!</p>
    </div>
    <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% featuredEvents.forEach(function(event) { %>
      <a href="/events/<%= event.slug %>" class="bg-gray-50 rounded-2xl border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow group">
        <div class="h-44 relative overflow-hidden bg-gradient-to-br from-indigo-500 to-purple-600">
          <% if (event.imagePath) { %>
          <img src="<%= assetUrl(event.imagePath) %>" alt="<%= event.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          <% } else { %>
          <div class="w-full h-full flex items-center justify-center">
            <i class="fas fa-<%= event.category ? event.category.icon : 'calendar-days' %> text-white/70 text-5xl"></i>
          </div>
          <% } %>
          <span class="absolute top-3 left-3 bg-white/95 text-indigo-700 text-xs font-semibold px-3 py-1 rounded-full">
            <i class="fas fa-<%= event.category ? event.category.icon : 'tag' %> mr-1"></i><%= event.category ? event.category.name : 'Umum' %>
          </span>
        </div>
        <div class="p-5">
          <p class="text-indigo-600 text-sm font-semibold mb-1"><i class="fas fa-calendar-day mr-1"></i><%= formatDate(event.eventDate) %></p>
          <h3 class="font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-indigo-600 transition-colors"><%= event.title %></h3>
          <p class="text-gray-500 text-sm mb-4 line-clamp-1"><i class="fas fa-location-dot mr-1"></i><%= event.venue %></p>
          <div class="flex items-center justify-between">
            <span class="font-bold text-gray-900"><%= Number(event.ticketPrice)===0 ? 'Gratis' : formatCurrency(event.ticketPrice) %></span>
            <span class="text-indigo-600 text-sm font-semibold group-hover:underline">Lihat Detail →</span>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>

<!-- CTA organizer -->
<section class="max-w-7xl mx-auto px-4 py-16">
  <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-3xl p-10 md:p-14 text-center relative overflow-hidden">
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">Punya Event untuk Diselenggarakan?</h2>
    <p class="text-indigo-100 mb-8 max-w-xl mx-auto">Buat, kelola, dan jual tiket event Anda dengan mudah bersama EventHub.</p>
    <% if (user && (user.role==='organizer' || user.role==='admin')) { %>
    <a href="/events/create" class="bg-white text-indigo-700 px-8 py-3 rounded-xl font-bold hover:bg-indigo-50 transition-colors inline-flex items-center gap-2">
      <i class="fas fa-plus"></i> Buat Event Sekarang
    </a>
    <% } else if (user) { %>
    <p class="text-indigo-100 text-sm">Fitur ini khusus untuk akun Penyelenggara. Hubungi admin untuk upgrade akun Anda.</p>
    <% } else { %>
    <a href="/auth/register" class="bg-white text-indigo-700 px-8 py-3 rounded-xl font-bold hover:bg-indigo-50 transition-colors inline-flex items-center gap-2">
      <i class="fas fa-user-plus"></i> Daftar sebagai Penyelenggara
    </a>
    <% } %>
  </div>
</section>
