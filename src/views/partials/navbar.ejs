<nav class="bg-white shadow-lg sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between items-center py-4">
      <a href="/" class="flex items-center space-x-2 shrink-0">
        <span class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center text-white">
          <i class="fas fa-ticket text-sm"></i>
        </span>
        <span class="text-xl font-bold text-gray-900">Event<span class="text-indigo-600">Hub</span></span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class="text-gray-700 hover:text-indigo-600 transition-colors <%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'text-indigo-600 font-semibold' : '' %>">Home</a>
        <a href="/events" class="text-gray-700 hover:text-indigo-600 transition-colors <%= typeof activeNav !== 'undefined' && activeNav === 'events' ? 'text-indigo-600 font-semibold' : '' %>">Events</a>

        <% if (user) { %>
        <div class="relative group">
          <button type="button" id="user-menu-button" class="flex items-center text-gray-700 hover:text-indigo-600 space-x-2">
            <img
              src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name || user.email) %>&background=4f46e5&color=ffffff&rounded=true&size=32&bold=true"
              alt="<%= user.name || user.email %>"
              class="w-8 h-8 rounded-full border-2 border-indigo-100 shadow-sm"
            />
            <span class="max-w-[10rem] truncate"><%= user.name || user.email %></span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="dropdown-menu absolute right-0 mt-2 w-52 bg-white rounded-md shadow-lg py-1 z-50 border border-gray-100">
            <div class="px-4 py-2 flex items-center space-x-2 border-b border-gray-100">
              <img
                src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name || user.email) %>&background=4f46e5&color=ffffff&rounded=true&size=32&bold=true"
                alt=""
                class="w-8 h-8 rounded-full"
              />
              <div class="min-w-0">
                <div class="text-sm font-medium text-gray-700 truncate"><%= user.name || user.email %></div>
                <div class="text-xs text-gray-400 capitalize"><%= user.role === 'organizer' ? 'Penyelenggara' : (user.role === 'admin' ? 'Admin' : 'Peserta') %></div>
              </div>
            </div>
            <a href="/auth/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
              <i class="fas fa-user mr-2 text-indigo-500"></i>Profil
            </a>
            <a href="/orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
              <i class="fas fa-ticket-alt mr-2 text-indigo-500"></i>Pesanan Saya
            </a>
            <% if (user.role==='organizer' || user.role==='admin' ) { %>
            <a href="/my-events" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
              <i class="fas fa-calendar-alt mr-2 text-indigo-500"></i>Event Saya
            </a>
            <% } %>
            <div class="border-t border-gray-100 mt-1 pt-1">
              <form method="POST" action="/auth/logout" class="w-full">
                <%- include('csrf-field') %>
                <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-700 transition-colors duration-150">
                  <i class="fas fa-sign-out-alt mr-2 text-red-500"></i>Logout
                </button>
              </form>
            </div>
          </div>
        </div>
        <% } else { %>
        <a href="/auth/login" class="text-gray-700 hover:text-indigo-600 transition-colors">Masuk</a>
        <a href="/auth/register" class="bg-indigo-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition-colors">Daftar</a>
        <% } %>
      </div>

      <!-- Mobile toggle -->
      <button type="button" id="mobile-menu-button" class="md:hidden text-gray-700 p-2" aria-label="Buka menu">
        <i class="fas fa-bars text-xl"></i>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 space-y-1 border-t border-gray-100 pt-3">
      <a href="/" class="block px-2 py-2 text-gray-700 hover:bg-gray-50 rounded-lg">Home</a>
      <a href="/events" class="block px-2 py-2 text-gray-700 hover:bg-gray-50 rounded-lg">Events</a>
      <% if (user) { %>
      <a href="/auth/profile" class="block px-2 py-2 text-gray-700 hover:bg-gray-50 rounded-lg">Profil</a>
      <a href="/orders" class="block px-2 py-2 text-gray-700 hover:bg-gray-50 rounded-lg">Pesanan Saya</a>
      <% if (user.role==='organizer' || user.role==='admin' ) { %>
      <a href="/my-events" class="block px-2 py-2 text-gray-700 hover:bg-gray-50 rounded-lg">Event Saya</a>
      <% } %>
      <form method="POST" action="/auth/logout">
        <%- include('csrf-field') %>
        <button type="submit" class="w-full text-left px-2 py-2 text-red-600 hover:bg-red-50 rounded-lg">Logout</button>
      </form>
      <% } else { %>
      <a href="/auth/login" class="block px-2 py-2 text-gray-700 hover:bg-gray-50 rounded-lg">Masuk</a>
      <a href="/auth/register" class="block px-2 py-2 text-indigo-600 font-semibold hover:bg-gray-50 rounded-lg">Daftar</a>
      <% } %>
    </div>
  </div>
</nav>

<script nonce="<%= cspNonce %>">
  (function () {
    var userMenuBtn = document.getElementById('user-menu-button');
    var mobileMenuBtn = document.getElementById('mobile-menu-button');
    var mobileMenu = document.getElementById('mobile-menu');

    if (userMenuBtn) {
      var dropdown = userMenuBtn.nextElementSibling;
      userMenuBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        dropdown.classList.toggle('is-open');
      });
      document.addEventListener('click', function () {
        dropdown.classList.remove('is-open');
      });
    }

    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', function () {
        mobileMenu.classList.toggle('hidden');
      });
    }
  })();
</script>
